# The live database is runtime data (continuous writes from agents in multiple
# repos), not source. Patterns are ANCHORED to the repo root so they do not
# also ignore seed/activity_logs.db, which the bootstrap depends on.
/activity_logs.db
/activity_logs.db-wal
/activity_logs.db-shm

# The usage cache. Unlike the log database this one is fully re-derivable —
# delete it, run usage_reader.py, and you are back where you started — but it
# is still machine-local runtime data, and it records paths from this machine.
/token_usage.db
/token_usage.db-wal
/token_usage.db-shm

__pycache__/

# The reader's run report, written beside the usage cache and served to the
# source-transparency panel. Regenerated on every import.
/token_usage.report.json
